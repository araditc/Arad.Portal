            function generateUrlFriend(title) {
                return title
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9]+/g, '-')  // Replace non-alphanumeric characters with a dash
                    .replace(/^-+|-+$/g, '');      // Remove leading and trailing dashes
            }

            // Handle Title input changes
            titleInput.addEventListener('input', function () {
                
                if (urlFriendAutoGenerated) {
                    const generatedUrlFriend = generateUrlFriend(titleInput.value);
                    urlFriendInput.value = generatedUrlFriend;
                }
            });

            // Handle UrlFriend manual input
            urlFriendInput.addEventListener('input', function () {
                urlFriendAutoGenerated = !urlFriendInput.value;  // Disable auto-generation if manually edited
            });

            // Ensure that URL friend stays synced initially if empty
            if (!urlFriendInput.value) {
                const generatedUrlFriend = generateUrlFriend(titleInput.value);
                urlFriendInput.value = generatedUrlFriend;
            }
