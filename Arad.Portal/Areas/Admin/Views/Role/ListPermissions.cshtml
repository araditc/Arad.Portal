@using Arad.Portal.Models.Shared.Permission
@model List<ListPermissions>
@{
    Layout = null;
}


<ul>
    @foreach (ListPermissions item in Model)
    {
        if (item.Childrens.Count != 0)
        {
    <li data-value="@item.Id">
        @UtilityLanguage.GetString($"PermissionTitle_{item.Title}")

        @if (item.Childrens.Count != 0)
        {
            <ul >
                @foreach (ListPermissions child in item.Childrens)
                {
                <li data-value="@child.Id">
                    @UtilityLanguage.GetString($"PermissionTitle_{child.Title}")
                    @if (child.Childrens.Count != 0)
                    {
                        @await Component.InvokeAsync("InnerPermissions", child)
                    }

                </li>
                }
            </ul>
        }
    </li>
        }
        else
        {
                <li data-value="@item.Id">
                    @UtilityLanguage.GetString($"PermissionTitle_{item.Title}")
                 </li>
         
        }

    }
</ul>
