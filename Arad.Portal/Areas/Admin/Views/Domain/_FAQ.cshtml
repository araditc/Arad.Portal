@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Arad.Portal.Models.Shared.DesignStructure.ModuleWithParametersValue

<div class="container">
    <h2>@UtilityLanguage.GetString("EnterFAQ")</h2>

    <form id="faqForm">
        <div id="faq-container">
            @for (int i = 0; i < Model.ParametersValue.FAQViewModel.FAQItems.Count; i++)
            {
                <div class="form-group" id="faq-item-@i">
                    <label>Question</label>
                    <input type="text" name="ParametersValue.FAQViewModel.FAQItems[@i].Question"
                           value="@Model.ParametersValue.FAQViewModel.FAQItems[i].Question"
                           class="form-control question" />

                    <label>Answer</label>
                    <textarea name="ParametersValue.FAQViewModel.FAQItems[@i].Answer"
                              class="form-control answer">@Model.ParametersValue.FAQViewModel.FAQItems[i].Answer</textarea>

                    <button type="button" class="btn btn-danger mt-2" onclick="deleteFaqItem(this, @i);">@UtilityLanguage.GetString("btn_Remove")</button>
                </div>
            }
        </div>

        <div class="col-12 text-center">
            <button type="button" onclick="addFaqButton(this);" class="btn btn-primary">@UtilityLanguage.GetString("AddFAQ")</button>
        </div>

        <div class="col-12 text-center">
            <button id="btnAddModuleWithParameters" class="btn btn-success bg-gradient btn-sm float-end m-1"
                    cn="@ViewBag.ColNumber" rn="@ViewBag.RowNumber" sec="@ViewBag.Section"
                    type="button" onclick="addModulesWithParams(this);">
                @UtilityLanguage.GetString("btn_Add")
            </button>
        </div>
    </form>
</div>