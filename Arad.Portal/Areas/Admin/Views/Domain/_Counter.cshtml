@model Arad.Portal.Models.Shared.DesignStructure.ModuleWithParametersValue
<div id="number-title-form">
    <h3>@UtilityLanguage.GetString("EnterNewItem")</h3>

    <div class="form-group">
        <label for="CounterTitle">@UtilityLanguage.GetString("Title")</label>
        <input type="text" class="form-control" id="CounterTitle">
    </div>

    <div class="form-group">
        <label for="CounterNumber">@UtilityLanguage.GetString("Number")</label>
        <input type="number" class="form-control" id="CounterNumber" min="0">
    </div>

    <div class="form-group">
        <label for="CounterIcon">@UtilityLanguage.GetString("Icon")</label>
        <input type="text" class="form-control" id="CounterIcon">
    </div>

    <div class="form-group">
        <label for="CounterColor">@UtilityLanguage.GetString("Color")</label>
        <input type="color" class="form-control-color" id="CounterColor" value="#FF8C00" title="@UtilityLanguage.GetString("ChooseColor")">
    </div>

    <div class="form-group">
        <label for="CounterShape">@UtilityLanguage.GetString("Shape")</label>
        <select class="form-control" id="CounterShape">
            <option value="square">@UtilityLanguage.GetString("Square")</option>
            <option value="circle">@UtilityLanguage.GetString("Circle")</option>
        </select>
    </div>

    <button type="button" class="btn btn-primary" onclick="addCounterItem()">
        @UtilityLanguage.GetString("btn_AddItem")
    </button>
</div>

<div id="items-container">
    <h3>@UtilityLanguage.GetString("YourItems")</h3>
</div>

<div class="col-12 text-center">
    <button id="btnAddModuleWithParameters" class="btn btn-success bg-gradient btn-sm float-end m-1"
            cn="@ViewBag.ColNumber" rn="@ViewBag.RowNumber" sec="@ViewBag.Section"
            onclick="addModulesWithParams(this);" type="button">
        @UtilityLanguage.GetString("btn_AddItem")
    </button>
</div>

<style>
    .form-control-color {
        padding: 0.375rem 0.75rem; /* Custom padding for color input to match form styling */
        height: calc(2.25rem + 2px); /* Match height of other form controls */
        max-width: 60px; /* Adjust width to ensure it’s more compact */
        cursor: pointer; /* Pointer cursor for color picker */
    }
</style>
