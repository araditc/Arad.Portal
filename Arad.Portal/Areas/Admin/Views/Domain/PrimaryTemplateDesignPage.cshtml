            function getsURL(input) {
                
                $("#cropped_result").remove();
                if (input.files && input.files[0]) {
                    var file = input.files[0];
                    currentFileName = file.name;
                    currentFileSize = file.size;

                    if (currentFileSize <= @ViewBag.PicSize) {
                        var reader = new FileReader();
                        reader.readAsDataURL(file);
                        reader.onload = function (e) {
                            var content = e.target.result;
                            if (content && content.startsWith("data:image")) {
                                $('#croppedImg').attr('src', content);
                                $("#uploadsModal").modal("show");
                            } else {
                                showError('@UtilityLanguage.GetString("AlertAndMessage_InvalidFormat")');
                                document.getElementById("image").value = "";
                                $("#cropped_result").remove();
                            }
                        };
                        reader.onerror = function () {
                            console.error("Error reading file:", reader.error);
                        };
                    } else {
                        showError('@UtilityLanguage.GetString("AlertAndMessage_InvalidFileSize")');
                        document.getElementById("image").value = "";
                        $("#cropped_result").remove();
                    }
                }
            }

