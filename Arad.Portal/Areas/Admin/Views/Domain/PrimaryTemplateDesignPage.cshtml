            function addColumnCustomizeCss() {
                
                var inputCss = $("#txtColumnCustCss").val().trim();
                if (inputCss === "") return; // Exit if input is empty

                // Select the target elements
                var finalColumnContent = $(`.row.finalColumnContent[guid='${selectedRow}'][cn='${colSelectedNumber}']`);
                var previewColumnContent = $(`.row.htmlColumnContentPreview[guid='${selectedRow}'][cn='${colSelectedNumber}']`);

                // Add the custom CSS class to both elements
                finalColumnContent.each(function() {
                    this.style.cssText = ` ${inputCss}`;
                });
                previewColumnContent.each(function() {
                    this.style.cssText = ` ${inputCss}`;
                });
            }

