            function sanitize(sender, flag) {
                editorId = "";
                if (flag) {
                    editorId = $(sender).attr("editorId");
                } else {
                    editorId = sender;
                }
                
                var editorInstance = tinymce.get(editorId);
                var htmlData = "";
                if (editorInstance) {
                    htmlData = editorInstance.getContent().trim();
                } else {
                    console.warn("Editor not found with id:", editorId);
                }
                if (htmlData != "") {
                    var dataToSend = JSON.stringify(htmlData);
                    $.ajax({
                        url: "@Url.Action("SanitizeContent", "Domain")",
                        type: 'Post',
                        data: dataToSend,
                        async: false,
                        contentType: "application/json; charset=utf-8",
                        statusCode: {
                            200: function (data) {
                                //show whether this html is valid or not
                                if (!data.isvalid) {
                                    $('#mainToastBody').html('<i class="fas fa-exclamation-triangle"></i>@UtilityLanguage.GetString("AlertAndMessage_InvalidEditorContent")');
                                    $('#mainToastBody').removeClass('text-bg-success');
                                    $('#mainToastBody').addClass('text-bg-danger');
                                    var toastDiv = $("#mainToast");
                                    $("#toastPanel").show();
                                    var toast = new bootstrap.Toast(toastDiv);
                                    toast.show();
                                    setTimeout(function () {
                                        tinymce.activeEditor.setContent(""), 3000
                                    });
                                } else //it is valid
                                {
                                    $('#mainToastBody').html('<i class="fas fa-check-circle"></i>@UtilityLanguage.GetString("AlertAndMessage_ValidEditorContent")');
                                    $('#mainToastBody').removeClass("text-bg-danger");
                                    $('#mainToastBody').addClass('text-bg-success');
                                    var toast = new bootstrap.Toast($("#mainToast"));
                                    toast.show();

                                    var res = `<div target='editor'>${htmlData}</div>`;
                                    if (flag) {
                                        $(sender).closest(".parent").find(".finalColumnContent").html(res);
                                        $(sender).closest(".parent").find(".htmlColumnContentPreview").html(htmlData);
                                    } else {
                                        $(`#${sender}`).closest(".parent").find(".finalColumnContent").html(res);
                                        $(`#${sender}`).closest(".parent").find(".htmlColumnContentPreview").html(htmlData);
                                    }

                                }
                            }
                        }
                    });
                }

            }

