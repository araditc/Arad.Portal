            function animateNumber(id) {
                const item = document.getElementById(id);
                const numberElement = item.querySelector('.number');
                const targetNumber = parseInt(numberElement.getAttribute('data-target'), 10);

                let currentNumber = 0;
                const increment = Math.ceil(targetNumber / 100); // Increment value based on the target number

                function updateNumber() {
                    currentNumber += increment;
                    if (currentNumber > targetNumber) {
                        currentNumber = targetNumber;
                    }
                    numberElement.innerText = currentNumber;

                    if (currentNumber < targetNumber) {
                        requestAnimationFrame(updateNumber);
                    }
                }

                updateNumber();
            }


            function addProgressBar() {
                const title = document.getElementById('title').value;
                const percentage = document.getElementById('percentage').value;
                const color = document.getElementById('color').value;

                if (!title || percentage < 0 || percentage > 100) {
                    alert("Please enter a valid title and percentage (0-100).");
                    return;
                }

                const id = `progress-${progressBars.length}`;

                // Add the progress bar data to the array
                progressBars.push({
                    id: id,
                    title: title,
                    percentage: percentage,
                    color: color
                });

                const progressBarHtml = `
                                                                <div class="progress-bar-item" id="${id}">
                                                                    <div class="progress">
                                                                        <div class="progress-bar ${color}" role="progressbar" style="width: ${percentage}%" aria-valuenow="${percentage}" aria-valuemin="0" aria-valuemax="100"></div>
                                                                    </div>
                                                                    <p>${title}: ${percentage}%</p>
                                                                    <button type="button" class="btn btn-danger btn-sm" onclick="deleteProgressBar('${id}')">Delete</button>
                                                                </div>
                                                            `;

                document.getElementById('progress-bars-container').insertAdjacentHTML('beforeend', progressBarHtml);

                // Clear form inputs
                document.getElementById('title').value = '';
                document.getElementById('percentage').value = '';
            }

            function deleteProgressBar(id) {
                // Find the progress bar by id and remove it from the DOM
                const progressBarItem = document.getElementById(id);
                if (progressBarItem) {
                    progressBarItem.remove();
                }

                // Optionally, remove the progress bar from the array (if needed for further logic)
                progressBars = progressBars.filter(bar => bar.id !== id);
            }

            function addFeature() {
                
                const title = document.getElementById('iconBlocksTitle').value;
                const description = document.getElementById('description').value;
                const icon = document.getElementById('iconPickerInput').value;
                const color = document.getElementById('iconBlocksColor').value;
                const shape = document.getElementById('shape').value;

                // Ensure inputs are valid
                if (!title || !description || !icon) {
                    alert("Please fill out all fields.");
                    return;
                }

                // Create the data object for the feature
                const featureData = {
                    title: title,
                    description: description,
                    icon: icon,
                    color: color,
                    shape: shape
                };

                // Add the feature data to the iconBlocks array
                iconBlocks.push(featureData);

                // Create the feature block
                const featureBlock = `
                                                            <div class="feature-item" style="background-color: #f9f9f9; padding: 20px; text-align: center; position: relative;">
                                                                <div class="${shape}" style="background-color: ${color}; padding: 20px;">
                                                                    <i class="${icon}" style="font-size: 40px; color: white;"></i>
                                                                </div>
                                                                <h5>${title}</h5>
                                                                <p>${description}</p>
                                                                <button class="btn btn-danger btn-sm" style="position: absolute; top: 10px; right: 10px;" onclick="removeFeature(this)">Remove</button>
                                                            </div>
                                                        `;

                // Add it to the preview section
                document.getElementById('feature-preview').insertAdjacentHTML('beforeend', featureBlock);

                // Clear the form
                document.getElementById('iconBlocksTitle').value = '';
                document.getElementById('description').value = '';
                document.getElementById('icon').value = '';
            }

            function removeFeature(button) {
                // Remove the parent feature item
                const featureItem = button.parentElement;
                featureItem.remove();

                // Optionally, you can also remove the item from iconBlocks here if needed
                // Find the index of the feature block to remove from iconBlocks based on the content
                const title = featureItem.querySelector('h5').textContent;
                const description = featureItem.querySelector('p').textContent;

                const index = iconBlocks.findIndex(item => item.title === title && item.description === description);
                if (index !== -1) {
                    iconBlocks.splice(index, 1); // Remove the item from the array
                }
            }
