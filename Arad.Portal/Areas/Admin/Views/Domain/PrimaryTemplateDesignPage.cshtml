                            const subtitleInput = item.querySelector('input[name="subtitles"]');
                            const widthInput = item.querySelector('input[name="width"]');
                            const heightInput = item.querySelector('input[name="height"]');

                            if (fileInput.files.length > 0 && subtitleInput.value && widthInput.value && heightInput.value) {
                                const file = fileInput.files[0];
                                var blob = URL.createObjectURL(file);
                                let byteArray = await fetchBlobAsByteArray(blob);
                                // Use await here since fetchBlobAsByteArray is async
                                const image = {
                                    ImageId: generateGuid(),
                                    FileName: file.name,
                                    Title: file.name.split('.')[0],
                                    Content: byteArrayToBase64(byteArray)
                                };

                                const pictureWithLabel = {
                                    ImageWidth: parseInt(widthInput.value),
                                    ImageHeight: parseInt(heightInput.value),
                                    Image: image,
                                    SubTitle: subtitleInput.value
                                };

                                pictureWithLabels.push(pictureWithLabel);
                            }
                        }

                        obj.ParametersValue.PictureWithLabels = pictureWithLabels;
                        url = "@Url.Action("GetPictureWithLabelViewComponent", "Domain")" + "?pictureWithLabels=" + encodeURIComponent(JSON.stringify(pictureWithLabels));
                        dataToSend = JSON.stringify(pictureWithLabels);

                        fetch("/fa-ir/Admin/Domain/GetPictureWithLabelViewComponent", {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: dataToSend // Ensure you're sending JSON
                        })
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Network response was not ok: ' + response.statusText);
                                }
                                return response.text(); // Use response.json() if expecting JSON
                            })
                            .then(result => {
                                
                                // Use the result (HTML or JSON) to update your UI
                                $(parent).find(".moduleDataPreview").html(result).removeClass("d-none");
                                $(parent).find(".htmlColumnContentPreview").html(result);
                            })
                            .catch(error => {
                                console.error('Error:', error);
                            });

                        break;
                    case "counter":
                        
                        ajaxType = "POST";
                        if (counters.length === 0) {
                            alert("No Counter to send.");
                            return;
                        }
                        obj.ParametersValue.Counters = counters;
                        url = "@Url.Action("GetCounterViewComponent", "Domain")" + "?counters=" + counters;
                        dataToSend = JSON.stringify(counters);
                        break;
                        case "contactus":
                        
                        ajaxType = "POST";
                        var iconClasses = document.querySelectorAll("input[name='IconClass[]']");
                        var urls = document.querySelectorAll("input[name='Url[]']");

            var iconsList = [];

            for (var i = 0; i < iconClasses.length; i++) {
                iconsList.push({
                    iconName: iconClasses[i].value,
                    link: urls[i].value,
                });
            }
            obj.ParametersValue.ContactUsList = iconsList;
                        url = "@Url.Action("GetContactUsViewComponent", "Domain")" + "?contactUsList=" + iconsList;
                         dataToSend = JSON.stringify(iconsList);
                        break;
                }

                var data = JSON.stringify(obj);
                data = `<div target='module'>${data}</div>`;
                var finalData = $(parent).find(".finalColumnContent").append(data);

                if (ajaxType == "GET") {
                    $.ajax({
                        type: ajaxType,
                        dataType: "html",
                        //contentType : "'application/json",
                        //data : dataToSend,
                        url: url,
                        success: function (result) {
                            
                            if (result != "") {
                                $(parent).find(".moduleDataPreview").html(result).removeClass("d-none");
                                $(parent).find(".htmlColumnContentPreview").html(result);
                                if (obj.ModuleName.toLowerCase() == "productlist") {
                                    
                                    $(".owl-carousel").owlCarousel({
                                        loop: true,
                                        rewind: false,
                                        rtl: true,
                                        navigation: true,
                                        autoplay: true,
                                        margin: 5,
                                        animateOut: 'fadeOut',
                                        animateIn: 'fadeIn',
                                        responsiveClass: true,
                                        nav: true,
                                        dots: false,
                                        autoplayHoverPause: false,
                                        items: 7,
                                        navText: ["<div class='nav-btn prev-slide'><i class='fas fa-chevron-left' style='line-height:5;font-size:larger;'></i></div>",
                                            "<div class='nav-btn next-slide'><i class='fas fa-chevron-right' style='line-height:5;font-size:larger;'></i></div>"],
                                        responsive: {
                                            0: {
                                                items: 1
                                            },
                                            600: {
                                                items: 5
                                            },
                                            1000: {
                                                items: 7
                                            }
                                        }
                                    });
                                }
                                else if (obj.ModuleName.toLowerCase() == "imagetextslider") {
                                    AfterCarouselLoad();
                                }
                            }
                        },
                    });
                } if (ajaxType == "POST") //contentTemplateModule
                {
                    $.ajax({
                        type: ajaxType,
                        dataType: "html",
                        contentType: "application/json",
                        data: dataToSend,
                        url: url,
                        success: function (result) {

                            if (result != "") {
                                $(parent).find(".moduleDataPreview").html(result).removeClass("d-none");
                                $(parent).find(".htmlColumnContentPreview").html(result);
                            }
                        },
                    });

                }

            }
            function generateGuid() {
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            }
              function ckConfig(editorId) {
                return {
                    selector: `textarea#${editorId}`,
                    license_key: 'gpl',
                    plugins: 'preview importcss searchreplace autolink autosave save directionality code visualblocks visualchars fullscreen image link media codesample table charmap pagebreak nonbreaking anchor insertdatetime advlist lists wordcount help charmap quickbars emoticons',
                    editimage_cors_hosts: ['picsum.photos'],
                    menubar: 'file edit view insert format tools table help',
                    toolbar: "undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | align numlist bullist | link image | table media | lineheight outdent indent | forecolor backcolor removeformat | charmap emoticons | code fullscreen preview | save print | pagebreak anchor codesample | ltr rtl",
                    autosave_ask_before_unload: true,
                    autosave_interval: '30s',
                    autosave_prefix: '{path}{query}-{id}-',
                    autosave_restore_when_empty: false,
                    autosave_retention: '2m',
                    image_advtab: true,

                    // ✅ Remove static contentId from here
                    // images_upload_url: '/Admin/File/UploadImage?contentId=' + encodeURIComponent(contentId),

                            images_upload_handler: function (blobInfo, success, failure, progress) {
                return new Promise((resolve, reject) => {
                    var contentId = generateGuid(); // ✅ Generate unique contentId per upload
                    var formData = new FormData();
                    formData.append('file', blobInfo.blob(), blobInfo.filename());

                    var xhr = new XMLHttpRequest();
                    xhr.withCredentials = false;

                    // ✅ Send `contentId` as a query parameter
                    xhr.open('POST', `/Admin/File/UploadImage?contentId=${encodeURIComponent(contentId)}`);

                    xhr.upload.onprogress = function (e) {
                        progress(e.loaded / e.total * 100);
                    };

                    xhr.onload = function () {
                        if (xhr.status !== 200) {
                            failure('HTTP Error: ' + xhr.status);
                            reject(new Error('HTTP Error: ' + xhr.status));
                            return;
                        }

                        try {
                            var json = JSON.parse(xhr.responseText);
                            if (!json || typeof json.location !== 'string') {
                                throw new Error('Invalid response from server');
                            }

                            success(json.location); // Pass the uploaded image URL
                            resolve(json.location);
                        } catch (e) {
                            failure('Invalid JSON: ' + xhr.responseText);
                            reject(e);
                        }
                    };

                    xhr.onerror = function () {
                        failure('Image upload failed due to a network error.');
                        reject(new Error('Image upload failed due to a network error.'));
                    };

                    xhr.send(formData);
                });
            },


                    file_picker_types: 'image',
                    file_picker_callback: function (callback, value, meta) {
                        if (meta.filetype === 'image') {
                            var input = document.createElement('input');
                            input.setAttribute('type', 'file');
                            input.setAttribute('accept', 'image/*');

                            input.onchange = function () {
                                var file = this.files[0];
                                var reader = new FileReader();
                                reader.onload = function () {
                                    callback(reader.result, {
                                        alt: file.name
                                    });
                                };
                                reader.readAsDataURL(file);
                            };

                            input.click();
                        }
                    },

                    importcss_append: true,
                    height: 600,
                    image_caption: true,
                    quickbars_selection_toolbar: 'bold italic | quicklink h2 h3 blockquote quickimage quicktable',
