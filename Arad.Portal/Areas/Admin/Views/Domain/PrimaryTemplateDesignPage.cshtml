                $("#send_pic").click(function () {
                    
                    $("#uploadModal").modal("hide");
                    var url = $("#galleryPic").attr("src");
                    var model = {};
                    var ratio = 1;
                    var width = "";
                    var height = "";
                    width = 120;
                    height = 120;


                    var model = {} //an instance of BgImage
                    model.base64ImageContent = url;
                    model.SelectedRowGuid = selectedRow;
                    model.SelectedSection = selectedSection;
                    model.ImageFileName = "";
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("SaveBackgroundImageToServer", "Domain")',
                        contentType: 'application/json',
                        data: JSON.stringify(model),
                        success: function (result) {
                            
                            if (result.status === "success") {
                                const url = result.bgImage.base64ImageContent;

                                if (selectedSection) {
                                    if (selectedSection === "container") {
                                        containerBgImage = result.bgImage;
                                        $(".dynamicContainerPart").addClass("bgCover").css("background-image", `url(${url})`);
                                    } else if (selectedSection === "footer") {
                                        footerBgImage = result.bgImage;
                                        $(".dynamicFooterPart").addClass("bgCover").css("background-image", `url(${url})`);
                                    } else if (selectedSection === "header") {
                                        headerBgImage = result.bgImage;
                                        $(".dynamicHeaderPart").addClass("bgCover").css("background-image", `url(${url})`);
                                    }
                                } else {
                                    $(`.row.sectionRow[guid='${selectedRow}']`)
                                        .attr("bgurl", url)
                                        .attr("bgtype", "2")
                                        .addClass("bgCover")
                                        .css("background-image", `url(${url})`);
                                    result.bgImage.selectedRowGuid = selectedRow;
                                    const index = bgImagesInSelectedRows.findIndex(item => item.selectedRowGuid == selectedRow);

                                    if (index !== -1) {
                                        bgImagesInSelectedRows.splice(index, 1); // Removes the element at the found index
                                    }

                                    bgImagesInSelectedRows.push(result.bgImage);
                                }
                            } else {
                                showError('@UtilityLanguage.GetString("AlertAndMessage_ErrorInLoadingImage")');
                            }
                        },
                    });

