@model Arad.Portal.Models.Shared.DesignStructure.ModuleWithParametersValue
<h2 class="mb-4">Create new icon</h2>

<div id="iconFields">
    <div class="icon-group mb-3">
        <label for="iconClass" class="form-label">FontAwesome class</label>
        <input type="text" class="form-control" name="IconClass[]" placeholder="e.g fa-brands fa-telegram" required>
        <small class="text-muted">e.g: fa-brands fa-facebook, fa-brands fa-instagram</small>
    </div>

    <div class="icon-group mb-3">
        <label for="url" class="form-label">Link</label>
        <input type="url" class="form-control" name="Url[]" placeholder="https://example.com" required>
    </div>
</div>

<button type="button" id="addIconField" class="btn btn-primary">Adding new field</button>

<div class="col-12 text-center mt-3">
    <button id="btnAddModuleWithParameters" class="btn btn-success bg-gradient btn-sm float-end m-1"
            cn="@ViewBag.ColNumber" rn="@ViewBag.RowNumber" sec="@ViewBag.Section"
            onclick="addModulesWithParams(this);" type="button">
        @UtilityLanguage.GetString("btn_Add")
    </button>
</div>
<script>
    document.getElementById("addIconField").addEventListener("click", function() {
        var container = document.getElementById("iconFields");

        var iconGroup = document.createElement("div");
        iconGroup.classList.add("icon-group", "mb-3");
        iconGroup.innerHTML = `
            <label class="form-label">FontAwesome class</label>
            <input type="text" class="form-control" name="IconClass[]" placeholder="e.g fa-brands fa-telegram" required>
        `;
        container.appendChild(iconGroup);

        var urlGroup = document.createElement("div");
        urlGroup.classList.add("icon-group", "mb-3");
        urlGroup.innerHTML = `
            <label class="form-label">Link</label>
            <input type="url" class="form-control" name="Url[]" placeholder="https://example.com" required>
        `;
        container.appendChild(urlGroup);
    });
</script>
