    function addToTable() {
        
        var flag = false;
        var selectedLang = $('#multiLangId').val();
        if (isUnique(selectedLang, 'multiLingualList', 1, '@UtilityLanguage.GetString("AlertAndMessage_LangUniqueness")')) {
            $("span[data-val-result='multiLangId']").html("");
            $("span[data-val-result='productName']").html("");
            $("span[data-val-result='urlFriend']").html("");

            if ($("#multiLangId").val() == "") {
                $("span[data-val-result='multiLangId']").html('@UtilityLanguage.GetString("AlertAndMessage_FieldEssential")');
                flag = true;
            }
            if ($("#productName").val() == "") {
                $("span[data-val-result='productName']").html('@UtilityLanguage.GetString("AlertAndMessage_FieldEssential")');
                flag = true;
            }
            if ($("#urlFriend").val() == "") {
                $("span[data-val-result='urlFriend']").html('@UtilityLanguage.GetString("AlertAndMessage_FieldEssential")');
                flag = true;
            }

            if (!flag) {
                var arr = $("#urlFriend").val().split(" ");
                var url = arr.join("-");

                $.ajax({
                    url: '@Url.Action("CheckUrlFriendUniqueness", "Product")' + "?id=" + '@Model.Id' + "&url=" + url,
                    type: 'Get',
                    dataType: 'json',
                    success: function (result) {
                        if (result.status == "Success") {
                            
                            var obj = {};
                            var urlFriend = url;
                            var finalUrl = "";
                            obj.LanguageId = $('#multiLangId').val();
                            obj.LanguageName = $("#multiLangId option:selected").text();
                            obj.Name = $('#productName').val();
                            obj.SeoTitle = $("#seoTitle").val();
                            obj.SeoDescription = $("#seoDescription").val();
                            obj.Description = $("#description").val();
                            obj.BodyContent = tinymce.activeEditor.getContent();
                            if (urlFriend != "") {
                                obj.UrlFriend = `/product/${urlFriend}`;
                                finalUrl = `/product/${urlFriend}`;
                            }
                            var dataToSend = JSON.stringify(tinymce.activeEditor.getContent());
                            $.ajax({
                                url: "@Url.Action("SanitizeContent", "Domain")",
                                type: 'Post',
                                data: dataToSend,
                                contentType: "application/json; charset=utf-8",
                                statusCode:
                                {
                                    200: function (data) {

                                        //show whether this html is valid or not
                                        if (!data.isvalid) {
                                            $('#mainToastBody').html('<i class="fas fa-exclamation-triangle"></i>@UtilityLanguage.GetString("AlertAndMessage_InvalidEditorContent")');
                                            $('#mainToastBody').removeClass("text-bg-success");
                                            $('#mainToastBody').addClass('text-bg-danger');
                                            var toastDiv = $("#mainToast");
                                            $("#toastPanel").show();
                                            var toast = new bootstrap.Toast(toastDiv);
                                            toast.show();
                                            setTimeout(function () {
                                                tinymce.activeEditor.setContent(""), 3000
                                            });
                                        }
                                        else //it is valid
                                        {
                                            obj.BodyContent = tinymce.activeEditor.getContent();
                                            obj.Tag = cnt.toString();

                                            multiLingualArr.push(obj);

                                            var tr = "<tr style='text-align:center;'><td>" + $("#multiLangId option:selected").text() +
                                                "</td><td style='display:none;'>" + $('#multiLangId').val() +
                                                "</td><td>" + $('#productName').val() +
                                                "</td><td>" + $("#seoTitle").val() +
                                                "</td><td>" + $("#seoDescription").val() +
                                                "</td><td>" + $("#description").val() +
                                                "</td><td dir='ltr'>" + finalUrl +
                                                "</td><td><button type='button' class='btn btn-sm btn-danger bg-gradient' cnt='" + obj.Tag + "' onclick='deleteFromTable(this);'>" +
                                                "<i class='fa fa-trash' ></i></button></td></tr>";

                                            if ($("#multiLingualList tr").length == 1 && $("#multiLingualList tr")[0].children.length == 1) {
                                                $("#multiLingualList tr")[0].remove();
                                            }
                                            $("#multiLingualList").append(tr);
                                            cnt = cnt + 1;
                                            $("#multiLangId").val("@ViewBag.LangId");
                                            $("#multiLangId").selectpicker("refresh");
                                            $("#productName").val("");
                                            $("#seoTitle").val("");
                                            $("#seoDescription").val("");
                                            $("#description").val("");
                                            tinymce.activeEditor.setContent("");
                                            $("#urlFriend").val("");
                                        }
                                    }
                                }
                            });
                        }
                        else {
                            $("span[data-val-result='urlFriend']").html('@UtilityLanguage.GetString("AlertAndMessage_UrlFriendIsNotUnique")');
                        }
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        return false;
                    }
                });
            }
        }
    }

