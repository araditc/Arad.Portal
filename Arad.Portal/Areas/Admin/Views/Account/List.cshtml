@section Scripts
    {
    <script>
        var password;
        var userId;
        
        $(document).ready(function () {
            
         
             $("#btnLoad").click(function () {
            
                var queryString = '';
                if ($("#name").val() !== '') {
                    queryString = '?name=' + $("#name").val();
                }

                if ($("#userName").val() !== '') {
                    if (queryString === '') {
                        queryString = '?userName=' + $("#userName").val();
                    } else {
                        queryString = queryString + '&userName=' + $("#userName").val();
                    }
                }

                var role = $('#roleSelect').find(":selected").val();
                if (role !== '0') {
                    if (queryString === '') {
                        queryString = '?role=' + role;
                    } else {
                        queryString = queryString + '&role=' + role;
                    }
                }

                var domain = $('#domainSelect').find(":selected").val();
                if (domain !== '0') {
                    if (queryString === '') {
                        queryString = '?domain=' + domain;
                    } else {
                        queryString = queryString + '&domain=' + domain;
                    }
                }

                window.location.href = '@Url.Action("List", "Account")' + queryString;
            });
        });


            //function ViewImage(address) {
            //    var tag = '<img src="' + address + '" width="500px" />';
               
            //}

        function changeActivation(id) {
            
                $.ajax({
                    type: 'Get',
                    url: '@Url.Action("ChangeActivation", "Account")' + '?id=' + id,
                    success: function(resultData) {
                        if (resultData.status === "success") {
                            
                            var html = '';

                            if (resultData.result === true) {
                                html = '<button onclick="changeActivation(\'' + id + '\')" class="btn btn-sm btn-success bg-gradient"> ' + '@UtilityLanguage.GetString("Active")' +' </button>';
                            } else {
                                html = '<button onclick="changeActivation(\'' + id + '\')" class="btn btn-sm btn-danger bg-gradient"> '+ '@UtilityLanguage.GetString("InActive")' +' </button>';
                            }
                            $('#activation' + id).html(html);
                        window.location.reload();
                        }

                        if (resultData.status === "error") {
                            showError(resultData.message);
                        }
                    }
                });
            }

        function restoreUser(id) {
            entityId = id;
			typeOfRequest = 'Get';
			confirmUrl = '@Url.Action("Restore", "Account")' + "/" + id,
			document.getElementById('confirmModalLabel').innerHTML = '@UtilityLanguage.GetString("btn_Restore")';
			document.getElementById('confirmModalBody').innerHTML = '@UtilityLanguage.GetString("AlertAndMessage_RestorationSureness")';
			$('#confirmModal').modal('show');
        }

        function EntityDelete(id) {
            entityId = id;
            typeOfRequest = 'Get';
            confirmUrl = `@Url.Action("Delete", "Account")/${id}`,
                document.getElementById('confirmModalLabel').innerHTML = '@UtilityLanguage.GetString("btn_Delete")';
            document.getElementById('confirmModalBody').innerHTML = '@UtilityLanguage.GetString("AlertAndMessage_DeletionSureness")';
            $('#confirmModal').modal('show');
        }

        function onChangePassword() {
            
            $('#confirmChangePasswordModal').modal('hide');

            $.ajax({
                type: typeOfRequest,
                url: confirmUrl,
                statusCode: {
                    200: function (resultData) {
                        
                        if (resultData.result) {
                            password = resultData.data;
                            document.getElementById('showChangePasswordModalLabel').innerHTML = '@UtilityLanguage.GetString("btn_ChangePassword")';
                            document.getElementById('showChangePasswordModalBody').innerHTML = resultData.data;
                            $('#showChangePasswordModal').modal('show');
                        }
                        else {
                            showError(resultData.message);
                        }
                    },
                    404: function () {
                        showError('@UtilityLanguage.GetString("AlertAndMessage_UserNotFound")');
                    },
                    403: function () {
                        showError('@UtilityLanguage.GetString("AlertAndMessage_NotAllowed")');
                    }
                }
            });
        }

        function changePassword(id) {
            
            entityId = id;
            typeOfRequest = 'PUT';
            confirmUrl = `@Url.Action("ChangePassword")?id=${entityId}`;
            document.getElementById('confirmChangePasswordModalLabel').innerHTML = '@UtilityLanguage.GetString("btn_ChangePassword")';
            document.getElementById('confirmChangePasswordModalBody').innerHTML = '@UtilityLanguage.GetString("AlertAndMessage_ChangePassConfirmation")';
            $('#confirmChangePasswordModal').modal('show');
        }

        function copyToClipboard() {
           
            navigator.clipboard.writeText(password).then(() => {

                $('#showChangePasswordModal').modal('hide');

                $('#mainToastBody').removeClass("text-bg-danger");
                $('#mainToastBody').addClass("text-bg-success");
                document.getElementById('mainToastBody').innerHTML = '<i class="far fa-check-circle"></i> @UtilityLanguage.GetString("AlertAndMessage_CopyDone")';

                var toastDiv = $("#mainToast");
                $("#toastPanel").show();
                var toast = new bootstrap.Toast(toastDiv);
                toast.show();

                setTimeout(function () {
                    window.location.reload();
                },
                    1500);
            });
        }

        function SendPassword() {
            
            $('#showChangePasswordModal').modal('hide');
            $("#toastPanel").show();
            $('#mainToastBody').removeClass("text-bg-danger");
            $('#mainToastBody').addClass("text-bg-success");

            $.ajax({
                type: "Get",
                url: `@Url.Action("CreatePasswordNotification")?userId=${entityId}&password=${password}`,
                statusCode: {
                    200: function (resultData) {
                        if (resultData.result) {
                           
                            document.getElementById('mainToastBody').innerHTML = '<i class="far fa-check-circle"></i> @UtilityLanguage.GetString("AlertAndMessage_SuccessfullyDone")';
                            $('#mainToastBody').removeClass("text-bg-danger");
                            $('#mainToastBody').addClass("text-bg-success");
                        }
                        else {
                            var msg = '@UtilityLanguage.GetString("AlertAndMessage_ErrorTryAgain")';
                            document.getElementById('mainToastBody').innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${msg}`;
                            $('#mainToastBody').removeClass("text-bg-success");
                            $('#mainToastBody').addClass("text-bg-danger");
                        }

                        var toastDiv = $("#mainToast");
                        $("#toastPanel").show();
                        var toast = new bootstrap.Toast(toastDiv);
                        toast.show();

                        setTimeout(function () {
                            $("#toastPanel").hide();
                        },
                            1500);
                    },
                    404: function () {
                        showError('@UtilityLanguage.GetString("AlertAndMessage_UserNotFound")');
                    },
                    403: function () {
                        showError('@UtilityLanguage.GetString("AlertAndMessage_NotAllowed")');
                    }
                }
            });
        }
        
    </script>
}





