@using Arad.Portal.DataLayer.Models.Shared.Counter
@model List<Arad.Portal.DataLayer.Models.Shared.Counter.Counter>

<div class="progress-bars-grid">
    @foreach (Counter item in Model)
    {
        <div class="dynamic-box">
            <div class="@item.Shape icon-container" style="background-color: @item.Color;">
                <i class="@item.Icon" aria-hidden="true"></i>
            </div>
            <h1 class="title">@item.Title</h1>
            <p class="number" data-target="@item.Number">+@item.Number</p>
        </div>
    }
</div>

<script>
    function animateNumber(target, element) {
        let currentNumber = 0;
        const increment = Math.ceil(target / 100);

        function updateNumber() {
            currentNumber += increment;
            if (currentNumber > target) {
                currentNumber = target;
            }
            element.innerText = "+" + currentNumber;

            if (currentNumber < target) {
                requestAnimationFrame(updateNumber);
            }
        }

        updateNumber();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const numberElements = document.querySelectorAll('.number');
        numberElements.forEach((element) => {
            const targetNumber = parseFloat(element.getAttribute('data-target'), 10);
            animateNumber(targetNumber, element);
        });
    });
</script>

<style>
    .progress-bars-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin: 0 auto;
        max-width: 1200px;
    }

    .dynamic-box {
        background-color: rgba(255, 255, 255, 0.9);
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
        padding: 40px;
        border-radius: 10px;
        text-align: center;
        width: calc(25% - 20px);
        box-sizing: border-box;
        transition: all 0.3s ease;
        min-height: 200px;
    }

    .icon-container {
        padding: 20px;
        position: relative;
        margin: 20px auto;
        width: 80px; /* Define width for centering */
        height: 80px; /* Define height for centering */
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%; /* Optional for circular shape */
    }

        .icon-container i {
            font-size: 40px;
            color: white;
        }

    .title {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #333;
    }

    .number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #007bff;
    }
</style>