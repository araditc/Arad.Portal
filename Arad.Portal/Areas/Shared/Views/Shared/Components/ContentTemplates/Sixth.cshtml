@using Arad.Portal.Models.Shared.Content
@model List<ContentGlance>

<div class="hex-grid">
    @for (int i = 0; i < Model.Count(); i += 9) // Iterate in chunks of 9 (4+5 or 5+4)
    {
        <div class="hex-row">
            @for (int j = i; j < i + 4 && j < Model.Count(); j++) // First row: 4 items
            {
                ContentGlance item = Model.ElementAt(j);
                <div class="hex">
                    <a class="hex-link" href="@item.UrlFriend" data-toggle="tooltip" title="@item.ImageTitle">
                        <img src="data:image/jpeg;base64,@item.DesiredImageUrl" alt="@item.ImageTitle">
                    </a>
                </div>
            }
        </div>
        <div class="hex-row offset">
            @for (int j = i + 4; j < i + 9 && j < Model.Count(); j++) // Second row: 5 items
            {
                ContentGlance item = Model.ElementAt(j);
                <div class="hex">
                    <a class="hex-link" href="@item.UrlFriend" data-toggle="tooltip" title="@item.ImageTitle">
                        <img src="data:image/jpeg;base64,@item.DesiredImageUrl" alt="@item.ImageTitle">
                    </a>
                </div>
            }
        </div>
    }
</div>

<!-- Ensure you have the necessary JavaScript to initialize tooltips -->
<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>