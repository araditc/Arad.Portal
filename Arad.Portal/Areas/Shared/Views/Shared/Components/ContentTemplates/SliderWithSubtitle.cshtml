@using Arad.Portal.DataLayer.Models.Shared
@using Arad.Portal.DataLayer.Models.Shared.DesignStructure
@using Arad.Portal.Models.Shared.Content
@model List<ContentGlance>
@{
    string outerElementAtr = "";
    string innerElementsAtr = "";
    LoadAnimationType animationTarget = (LoadAnimationType)ViewBag.LoadAnimationType;
    if (animationTarget == LoadAnimationType.OuterElement)
    {
        outerElementAtr = $"data-animation='animated {ViewBag.LoadAnimation}'";
    }
    else
    {
        innerElementsAtr = $"data-animation='animated {ViewBag.LoadAnimation}'";
    }
    string baseAdd = Config["BaseAddress"];
}

<div id="contentTemplateSliderSubtitle" class="carousel slide" data-bs-ride="carousel" @outerElementAtr>
    <div class="carousel-inner">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="carousel-item @(i == 0 ? "active" : "")" @innerElementsAtr>
                <div class="row">
                    <div class="col-12 m-auto">
                        <div class="row">
                            <div class="col-6 card m-0 p-0" style="background-color: #e9f8f8;">
                                <div class="card-body m-5">
                                    <h5 class="text-start fs-4 fw-bold pb-4 border-bottom">@Model[i].Title</h5>
                                    <div class="row fs-6">@Model[i].SubTitle</div>
                                    <div class="float-start ms-4 mt-5">
                                        <a class="btn btn-lg btn-dark text-decoration-none mt-5" role="button" href="@(!string.IsNullOrWhiteSpace(Model[i].UrlFriend) ? $"{Model[i].UrlFriend}" : $"blog/{Model[0].ContentCode}")">
                                            @UtilityLanguage.GetString("design_Continue")
                                        </a>
                                    </div>
                                </div>
                                <div class="mt-5 m-3 border-top"></div>
                            </div>
                            <div class="col-6 m-0 p-0">
                                <picture>
                                    <img class="d-block w-100 h-100 rounded-0"
                                         src="data:image/jpeg;base64,@Model[i].DesiredImageUrl"
                                         style="object-fit:contain; width:120px"
                                         alt="@Model[i].Images.FirstOrDefault(x => x.ImageRatio == ImageRatio.Square)?.Title">
                                </picture>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Next and Previous Buttons -->
    <button class="carousel-control-prev custom-prev" type="button" data-bs-target="#contentTemplateSliderSubtitle" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">@UtilityLanguage.GetString("tbl_PreviousPage")</span>
    </button>
    <button class="carousel-control-next custom-next" type="button" data-bs-target="#contentTemplateSliderSubtitle" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">@UtilityLanguage.GetString("tbl_NextPage")</span>
    </button>

    <!-- Pagination indicators (tiny circles) -->
    <div class="carousel-indicators">
        @for (int i = 0; i < Model.Count; i++)
        {
            <button type="button" data-bs-target="#contentTemplateSliderSubtitle" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="true" aria-label="Slide @i"></button>
        }
    </div>
</div>

