@using Arad.Portal.DataLayer.Models.Shared.IconBlock
@model List<Arad.Portal.DataLayer.Models.Shared.IconBlock.IconBlock>

<style>
    .feature-container {
        display: flex;
        flex-wrap: wrap; /* Allows items to wrap to the next line */
        margin: -5px; /* Adjust for the margins on feature-item */
    }

    .feature-item {
        background-color: #f9f9f9;
        padding: 10px; /* Reduced padding */
        margin: 5px; /* Margin for spacing between items */
        display: flex;
        align-items: center;
        flex: 0 0 calc(33.33% - 10px); /* Sets width to one-third of the container minus margin */
        box-sizing: border-box; /* Include padding and border in width calculation */
    }

    .feature-icon {
        width: 60px; /* Reduced icon size */
        height: 60px; /* Reduced icon size */
        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 8px; /* Adjust margin for spacing */
    }

    .feature-content {
        text-align: right; /* Align text to the right for RTL languages */
        direction: rtl; /* Set direction to RTL */
    }

        .feature-content h5 {
            margin: 0;
            font-size: 14px; /* Reduced title font size */
        }

        .feature-content p {
            margin-top: 2px; /* Reduced margin */
            font-size: 10px; /* Reduced description font size */
        }

    .circle {
        border-radius: 50%;
    }
</style>

<div class="feature-container">
    @foreach (IconBlock item in Model)
    {
        <div class="feature-item">
            <div class="feature-icon @item.Shape" style="background-color: @item.Color;">
                <i class="@item.Icon" style="font-size: 24px; color: white;"></i> <!-- Reduced icon font size -->
            </div>
            <div class="feature-content">
                <h5>@item.Title</h5>
                <p>@item.Description</p>
            </div>
        </div>
    }
</div>
