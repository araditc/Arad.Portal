@using Arad.Portal.DataLayer.Models.Shared
@using Arad.Portal.DataLayer.Models.Shared.Product

@model ProductOutputDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string dir = HelpersMethods.GetDirection(CultureInfo.CurrentCulture);

    var realPrice = ViewBag.Price.PriceValue;
    string score = @UtilityLanguage.GetString("ProductScore");
    System.Diagnostics.Debug.Assert(User.Identity != null, "User.Identity != null");
    bool like = User.Identity.IsAuthenticated && ViewBag.Like ? true : false;
}
@section Styles
{

    <link href="@Url.Content("~/ImageSlider/slick.css")" rel="stylesheet" />

    <link href="@Url.Content("~/ImageSlider/jquery.fancybox.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/ImageSlider/ImageSlider.css")" rel="stylesheet" />
    <style>
        .smlImg {
            border-radius: 10%;
        }

        a.ratePro {
            color: transparent;
        }

            a.ratePro:hover {
                color: transparent;
            }

        .card {
            position: relative;
            display: flex;
            padding: 20px;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #fff;
            background-clip: border-box;
            border: 1px solid #d2d2dc;
            border-radius: 11px;
            -webkit-box-shadow: 0px 0px 5px 0px rgb(249, 249, 250);
            -moz-box-shadow: 0px 0px 5px 0px rgba(212, 182, 212, 1);
            box-shadow: 0px 0px 5px 0px rgb(161, 163, 164)
        }

        .media img {
            width: 60px;
            height: 60px
        }

        .reply a {
            text-decoration: none
        }

        .sold_stars i {
            color: orange
        }

        .lblMdl {
            padding: 0.5rem 0rem;
        }

        .imgParent {
            position: relative;
        }

            .imgParent .fa-heart {
                position: absolute;
                left: 2%;
                top: 2%;
            }
    </style>
}
<div class="container">
    <div class="row">
        <div class="col-12 col-lg-6 border border-1 rounded py-1" @*dir="ltr"*@>
            <div class="row g-2">
                <div class="sold_stars ratePart col-10 col-md-4 px-1">
                    @for (int i = 1; i <= Model.LikeRate; i++)
                    {
                        <a href="#"
                           role="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title=@($"{UtilityLanguage.GetString("ContentScore")}_{i}") onclick="RatePro(@i);" class="ratePro">
                            <i class="fas fa-star"></i>
                        </a>
                    }
                    @if (Model.HalfLikeRate)
                    {
                        <a href="#" class="ratePro"
                           role="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title=@($"{UtilityLanguage.GetString("ContentScore")}_{Model.LikeRate+1}") onclick="RatePro(@Model.LikeRate+1);">
                            <i class="fas fa-star-half-alt"></i>
                        </a>
                    }
                    @for (int i = (Model.HalfLikeRate ? Model.LikeRate + 2 : Model.LikeRate + 1); i <= 5; i++)
                    {
                        <a href="#" class="ratePro"
                           role="button" data-bs-toggle="tooltip" data-bs-placement="bottom" onclick="RatePro(@i);" title=@($"{UtilityLanguage.GetString("ContentScore")}_{i}")>
                            <i class="far fa-star"></i>
                        </a>
                    }
                </div>
                <div class="col-1 offset-1 col-md-4 offset-md-4 px-3">
                    <a href="#" role="button" class="float-end fs-4" data-bs-toggle="tooltip" onclick="AddToFavoriteList('@Model.ProductCode');"
                       data-bs-placement="bottom" title="@UtilityLanguage.GetString("AlertAndMessage_AddToFavoriteList")">
                        @if (!like)
                        {
                            <i class="far fa-heart"></i>
                        }
                        else
                        {
                            <i class="fas fa-heart"></i>
                        }

                    </a>
                </div>
            </div>
            <div id="detail">
                <div class="product-images demo-gallery border-0">
                    <div class="main-img-slider">
                        @foreach (Image item in Model.Images)
                        {
                            <a data-fancybox="gallery" class="d-block" href="data:image/jpeg;base64,@item.Content" style="width:1000px;">
                                <img src="data:image/jpeg;base64,@item.Content" style="width:800px;" class="img-fluid" alt="">
                            </a>
                        }
                    </div>

                    <ul class="thumb-nav">
                        @foreach (Image item in Model.Images)
                        {
                            <li>
                                <img class="smlImg" src="data:image/jpeg;base64,@item.Content" style="width:75px;" alt="">
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="row justify-content-center compareSection mb-2">
                <div class="col-12 d-flex justify-content-end ">
                    <button type="button" class="btn btn-success btn-sm pe-3 mt-3 me-2" id="btnAddToCompareList">
                        <i class="fas fa-compress px-1 mt-1"></i>
                        @UtilityLanguage.GetString("btn_AddToCompareList")
                    </button>

                    <a class="btn btn-secondary btn-sm pe-3 mt-3" id="btnCompareListView" asp-controller="Product" asp-action="Compare">

                        @UtilityLanguage.GetString("btn_CompareListView")
                    </a>
                </div>


            </div>
            <div class="row commentSection">


                <textarea class="form-control text-start w-100 bg-light" id="commentPart" name="content" rows="3" placeholder="@UtilityLanguage.GetString("AlertAndMessage_WriteComment")"></textarea>
                <input type="button" class="btn btn-secondary bg-gradient mt-2 float-end" id="btnAddComment" value="@UtilityLanguage.GetString("btn_Insert")" />

            </div>

        </div>
        <div class="col-12 col-lg-6">
            <div class="card" style="border: none;">
                <div class="card-header"></div>
                <div class="card-body">
                    <h6 class="card-title text-start">
                        @(Model.MultiLingualProperties.Any(p => p.LanguageId == ViewBag.CurLanguageId) ?
                            Model.MultiLingualProperties.FirstOrDefault(p => p.LanguageId == ViewBag.CurLanguageId)?.Name : "")
                    </h6>
                    <p class="card-text text-start" style="max-height: 260px;overflow-y: auto">
                        @*text-truncate*@
                        @(Model.MultiLingualProperties.Any(p => p.LanguageId == ViewBag.CurLanguageId) ?
                            Model.MultiLingualProperties.FirstOrDefault(p => p.LanguageId == ViewBag.CurLanguageId)?.Description : "")
                    </p>
                    <div class="border rounded-3 m-2 mb-4 p-2" style="max-height: 260px;overflow-y: auto">
                        @{
                            if (Model.MultiLingualProperties.Any(p => p.LanguageId == ViewBag.CurLanguageId) &&
                            !string.IsNullOrEmpty(Model.MultiLingualProperties.FirstOrDefault(p => p.LanguageId == ViewBag.CurLanguageId)?.BodyContent))
                            {
                                @Html.Raw(Model.MultiLingualProperties.FirstOrDefault(p => p.LanguageId == ViewBag.CurLanguageId)?.BodyContent)
                            }
                        }
                    </div>
                    <div id="specValuesInventory">
                        @foreach (ProductSpecificationValue spec in Model.Specifications.Where(v => v.LanguageId == ViewBag.CurLanguageId))
                        {
                            string[] arr = spec.Values.Split("|");
                            <div class="row border-top m-1 py-2 specRow" specid="@spec.SpecificationId">
                                <div class="col-12 col-md-3">
                                    <span>@spec.SpecificationName :</span>
                                </div>
                                <div class="col-12 col-md-9">
                                    <div class="d-flex flex-row">
                                        @foreach (string item in arr)
                                        {
                                            string attr = "";
                                            @if (!Model.Inventory.Any(d => d.SpecValues
                                           .Any(a => a.SpecificationId == spec.SpecificationId && a.SpecificationValue == item) && d.Count > 0) && arr.Length > 1)
                                            {
                                                attr = "disabled";
                                            }
                                            <div>
                                                <div class="form-check m-auto d-inline-block pe-3">
                                                    <input class="form-check-input specRadio" type="radio" name="@spec.SpecificationId" value="@item" @attr @(arr.Length == 1 ? "checked" : "")>
                                                    <label class="form-check-label">
                                                        @item
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                    @{
                        if (Model.TotalInventory > 0)
                        {
                            <div class="mt-4 p-2 bg-secondary bg-opacity-10 border rounded-3">
                                <div class="row  mt-2">
                                    <div class="col-6 col-md-3 col-lg-3">
                                        <span>@UtilityLanguage.GetString("PriceValue"):</span>
                                    </div>
                                    @if (realPrice == Model.PriceValWithPromotion && Model.GiftProduct == null)
                                    {
                                        <div class="col-6 col-md-3 col-lg-5">
                                            <p>
                                                <mark>
                                                    @($"{Convert.ToInt64(Model.PriceValWithPromotion):n0} {ViewBag.Price.Prefix}")
                                                </mark>
                                            <p>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (Model.GiftProduct == null)
                                        {
                                            <div class="col-6 col-md-3 col-lg-3">
                                                <p>
                                                    <mark>
                                                        @($"{Convert.ToInt64(Model.PriceValWithPromotion):n0}  {ViewBag.Price.Prefix}")
                                                    </mark>
                                                </p>
                                            </div>
                                            <div class="col-6 col-md-3 col-lg-3">
                                                <p>
                                                    <span>
                                                        @($"{Convert.ToInt64(realPrice):n0}  {ViewBag.Price.Prefix}")
                                                    </span>
                                                </p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-6 col-md-3 col-lg-3">
                                                <p>
                                                    <mark>
                                                        @($"{Convert.ToInt64(Model.PriceValWithPromotion):n0} {ViewBag.Price.Prefix}")
                                                    </mark>
                                                </p>
                                            </div>
                                            <div class="col-6 col-md-3 col-lg-3">
                                                <p>@UtilityLanguage.GetString("byBuying")</p>
                                                <span>
                                                    @if (Model.Promotion.BoughtCount != null)
                                                    {
                                                        @Model.Promotion.BoughtCount.Value
                                                    }
                                                </span>
                                                <p>@UtilityLanguage.GetString("AsGift")</p>
                                                <span>
                                                    @if (Model.Promotion.PromotedCountofUnit != null)
                                                    {
                                                        @Model.Promotion.PromotedCountofUnit.Value
                                                    }
                                                </span>
                                                <a class="bbb_deals_item_name" href="/product/@Model.GiftProduct.ProductCode">
                                                    @(Model.GiftProduct.MultiLingualProperties.Any(p => p.LanguageId == ViewBag.CurLanguageId) ?
                                                    Model.GiftProduct.MultiLingualProperties.FirstOrDefault(p => p.LanguageId == ViewBag.CurLanguageId)?.Name :
                                                    Model.GiftProduct.MultiLingualProperties.FirstOrDefault()?.Name)
                                                </a>
                                            </div>
                                        }

                                    }

                                    <div class="col-6  col-lg-4 text-start">
                                        <span class="inventorySpan">@UtilityLanguage.GetString("InventoryInStore")</span>
                                        <span id="currentInventory">@Model.TotalInventory</span>
                                        <span class="unavailableSpan text-danger fs-5 fw-bold d-none">@UtilityLanguage.GetString("UnAvailable")</span>
                                    </div>
                                </div>
                                <div class="row existPart">
                                    <div class="col-6 col-md-3 col-lg-4 d-flex justify-content-start">
                                        <label class="lblMdl">@UtilityLanguage.GetString("OrderCnt") :</label>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <input type="number" class="form-control" id="orderCnt" name="orderCnt" min="0" value="1" />
                                    </div>
                                    <div class="col-6 col-md-4 d-flex justify-content-center">
                                        <button type="button" id="btnAddToCart" class="btn btn-success  @(Model.TotalInventory <= 0 ? "disabled" : "")" prid="@Model.Id">
                                            <span class="shopping-cart">
                                                <em class="fa fa-shopping-basket"></em>
                                            </span>
                                            <span> @UtilityLanguage.GetString("btn_AddToShoppingCart")</span>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="row unAvailablePart">
                                <div class="col-6 col-md-3 offset-md-3">
                                    <button class="btn btn-light bg-gradient" disabled>@UtilityLanguage.GetString("UnAvailable")</button>
                                </div>
                                <div class="col-6">
                                    <button class="btn btn-danger bg-gradient" id="btnInformMe">@UtilityLanguage.GetString("btn_InformMe")</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="mb-3 mt-3 px-3 bg-secondary bg-opacity-10">
                <div class="row">
                    <div class="col-12">

                        @foreach (CommentVm item in Model.Comments)
                        {
                            @await Component.InvokeAsync("CommentSection", item)
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script src="@Url.Content("~/js/CommentSection/cmt.js")"></script>
<script src="@Url.Content("~/ImageSlider/slick.min.js")"></script>

<script src="@Url.Content("~/ImageSlider/jquery.fancybox.min.js")"></script>


@if (dir == "rtl")
{
    <script src="@Url.Content("~/ImageSlider/ImageSlider-rtl.js")"></script>
}
else
{
    <script src="@Url.Content("~/ImageSlider/ImageSlider-ltr.js")"></script>
}

<script type="text/javascript">
    var DivId;
    var Sender;
    var inventoryList = [];
    $(document).ready(function () {
        
        inventoryList = @Json.Serialize(Model.Inventory);
        $(".specRadio").click(function () {
            
            selectedSpecVals = [];
            $(".specRow").each(function () {
                var specid = $(this).attr("specid");
                if ($("input[name='" + specid + "']:checked").val() != undefined) {
                    var text = $("input[name='" + specid + "']:checked").val();
                    selectedSpecVals.push({ Value: specid, Text: text });
                }
            });
            
            var obj = {};
            obj.ProductId = '@Model.Id';
            obj.SelectedSpecs = selectedSpecVals;
            obj.Count = null;

            $.ajax({
                url: '@Url.Action("FindProductInventory", "Product")',
                contentType: "application/json",
                data: JSON.stringify(obj),
                type: "POST",
                dataType: "json",
                beforeSend: function () {
                },
                success: function (result) {
                    
                    if (result.status === "success") {
                        $("#currentInventory").html(result.cnt);
                        if (result.cnt == "0") {
                            $(".existPart").addClass("d-none");
                            $("#currentInventory").addClass("d-none");
                            $(".inventorySpan").addClass("d-none");
                            $(".unavailableSpan").removeClass("d-none");
                        }
                        else {
                            if ($(".existPart").hasClass("d-none")) {
                                $(".existPart").removeClass("d-none");
                            }
                            $("#currentInventory").removeClass("d-none");
                            $(".inventorySpan").removeClass("d-none");
                            $(".unavailableSpan").addClass("d-none");

                        }

                    }
                }
            });
        });

        $("#btnAddComment").click(function (e) {
            
            if ('@User.Identity.IsAuthenticated' === 'True') {
                if ($("#commentPart").val() != "") {

                    var obj = {};
                    obj.ReferenceId = `p*${'@Model.Id'}`;
                    obj.Content = $("#commentPart").val();
                    obj.ParentId = null;

                    $.ajax({
                        url: '@Url.Action("SubmitComment", "Comment")',
                        contentType: "application/json",
                        data: JSON.stringify(obj),
                        type: "Post",
                        beforeSend: function () {
                        },
                        success: function (result) {
                            
                            if (result.status === "Success") {

                                $("#commentPart").val("@UtilityLanguage.GetString("AlertAndMessage_SubmitComment")");
                                setTimeout(function () {
                                    $("#commentPart").val("");
                                },
                                    3000);
                                //location.reload();
                            } else {
                                showError(result.message);
                            }
                        }
                    });
                }
            } else {
                document.getElementById('mainToastBody').innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${'@UtilityLanguage.GetString("AlertAndMessage_LoginFirst")'}`;
                $('#mainToastBody').removeClass("text-bg-success");
                $('#mainToastBody').addClass("text-bg-danger");
                var toastDiv = $("#mainToast");
                $("#toastPanel").show();
                var toast = new bootstrap.Toast(toastDiv);
                toast.show();

                setTimeout(function () {
                    $("#toastPanel").hide();
                }, 3000);
            }
        });


        $("#btnAddToCart").click(function () {
            
            var cnt = $("#orderCnt").val();
            if ('@User.Identity.IsAuthenticated' === 'True')//user is authenticated and can add product to its cart
            {
                
                specVals = [];
                $(".specRow").each(function () {
                    var specid = $(this).attr("specid");
                    if ($("input[name='" + specid + "']:checked").val() == undefined) {
                        $('#mainToastBody').html("<i class='far fa-check-circle'></i>" + '@UtilityLanguage.GetString("AlertAndMessage_SelectAllSpecificationValues")');
                        $('#mainToastBody').removeClass("text-bg-success");
                        $('#mainToastBody').addClass("text-bg-danger");
                        $("#toastPanel").show();
                        var toast = new bootstrap.Toast($("#mainToast"));
                        toast.show();
                        setTimeout(function () {
                            $("#toastPanel").hide();
                        }, 3000);
                        return;
                    }
                    else {
                        var specid = $(this).attr("specid");
                        specVal = $("input[name='" + specid + "']:checked").val();
                        var obj = {};
                        obj.SpecificationId = specid;
                        obj.SpecificationValue = specVal;
                        specVals.push(obj);
                    }
                });
                if ($(".specRow").length == specVals.length) {
                    
                    var obj = {};
                    obj.Code = '@Model.ProductCode';
                    obj.Count = parseInt(cnt);
                    obj.SpecVals = specVals;
                    obj.CartDetailId = "";

                    $.ajax({
                        url: `/${'@ViewBag.LanIcon'}/Basket/AddProToBasket`,
                        contentType: 'application/json',
                        type: 'POST',
                        data: JSON.stringify(obj),
                        dataType: 'json',
                        beforeSend: function () {
                        },
                        success: function (result) {
                            if (result.status == "Succeed") {
                                
                                setProductCountInCart(result.cnt);

                                $('#mainToastBody').html(`<i class="far fa-check-circle"></i> ${result.message}`);
                                $('#mainToastBody').removeClass("text-bg-danger");
                                $('#mainToastBody').addClass("text-bg-success");
                                $("#toastPanel").show();
                                var toast = new bootstrap.Toast($("#mainToast"));
                                toast.show();
                                setTimeout(function () {
                                    $("#toastPanel").hide();
                                }, 2500);
                            }
                            else {

                                document.getElementById('mainToastBody').innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${result.message}`;
                                $('#mainToastBody').removeClass("text-bg-success");
                                $('#mainToastBody').addClass("text-bg-danger");
                                $("#toastPanel").show();
                                var toast = new bootstrap.Toast($("#mainToast"));
                                toast.show();
                                setTimeout(function () {
                                    $("#toastPanel").hide();
                                }, 2500);
                            }

                        }
                    });
                }

            } else {
                window.location.href = '@Url.Action("login", "Account")' + `?returnUrl=/${"@ViewBag.LanIcon"}/Product/${'@Model.ProductCode'}`;
            }
        });


        $("#btnInformMe").click(function () {
            
            if ('@User.Identity.IsAuthenticated' === 'True')//user is authenticated and can add product to its cart
            {
                

                $.ajax({
                    url: `/${'@ViewBag.LanIcon'}/Product/InformMe?code=` + '@Model.ProductCode',
                    contentType: 'application/json',
                    type: 'Get',
                    dataType: 'json',
                    beforeSend: function () {
                    },
                    success: function (result) {
                        if (result.status == "Succeed") {
                            
                            $('#mainToastBody').html(`<i class="far fa-check-circle"></i> ${result.message}`);
                            $('#mainToastBody').removeClass("text-bg-danger");
                            $('#mainToastBody').addClass("text-bg-success");
                            $("#toastPanel").show();
                            var toast = new bootstrap.Toast($("#mainToast"));
                            toast.show();
                            setTimeout(function () {
                                $("#toastPanel").hide();
                            }, 2500);
                        }
                        else {

                            document.getElementById('mainToastBody').innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${result.message}`;
                            $('#mainToastBody').removeClass("text-bg-success");
                            $('#mainToastBody').addClass("text-bg-danger");
                            $("#toastPanel").show();
                            var toast = new bootstrap.Toast($("#mainToast"));
                            toast.show();
                            setTimeout(function () {
                                $("#toastPanel").hide();
                            }, 2500);
                        }

                    }
                });
            } else {
                window.location.href = `/${"@ViewBag.LanIcon"}/Account/login?returnUrl=/${"@ViewBag.LanIcon"}/Product/${'@Model.ProductCode'}`;
            }
        })

        $("#btnAddToCompareList").click(function () {

            $.ajax({
                url: `/${'@ViewBag.LanIcon'}/Product/AddToComapareList?code=` + '@Model.ProductCode',
                contentType: 'application/json',
                type: 'Get',
                dataType: 'json',
                beforeSend: function () {
                },
                success: function (result) {
                    if (result.status == "Succeed") {
                        

                        $('#mainToastBody').html(`<i class="far fa-check-circle"></i> ${result.message}`);
                        $('#mainToastBody').removeClass("text-bg-danger");
                        $('#mainToastBody').addClass("text-bg-success");
                        $("#toastPanel").show();
                        var toast = new bootstrap.Toast($("#mainToast"));
                        toast.show();
                        setTimeout(function () {
                            $("#toastPanel").hide();
                        }, 2500);
                    }
                    else {

                        document.getElementById('mainToastBody').innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${result.message}`;
                        $('#mainToastBody').removeClass("text-bg-success");
                        $('#mainToastBody').addClass("text-bg-danger");
                        $("#toastPanel").show();
                        var toast = new bootstrap.Toast($("#mainToast"));
                        toast.show();
                        setTimeout(function () {
                            $("#toastPanel").hide();
                        }, 2500);
                    }

                }
            });
        });

    });



    function AddToFavoriteList(productCode) {
        
        if ('@like' == "True") {
            window.location.href = '@Url.Action("Favorites", "Account")' + "?type=product";
        }
        else if ('@User.Identity.IsAuthenticated' == "True") {
            $.ajax({
                url: '@Url.Action("AddToFavList", "Comment")' + `?code=${productCode}&name=product`,
                contentType: "application/json",
                type: "Get",
                beforeSend: function () {
                },
                success: function (result) {
                    
                    if (result.status == "Succeed") {

                        window.location.reload();
                    }
                }
            });
        } else
            window.location.href = '@Url.Action("Login", "Account")' + `?returnUrl=${'@ViewBag.LanIcon'}/product/${productCode}`;

    }

    function RatePro(score) {
        
        var isAllow = false;
        if ('@User.Identity.IsAuthenticated' == 'True') {
            if ('@ViewBag.HasRateBefore' == 'True') {
                if (score != parseInt('@ViewBag.PreRate'))
                    isAllow = true;
            }
            else {
                isAllow = true;
            }
        } else {
            window.location.href = '@Url.Action("Login", "Account")' + `?returnUrl=${'@ViewBag.LanIcon'}/product/${productCode}`;
        }
        var obj = {};
        if (isAllow) {

            obj.EntityId = '@Model.Id';
            obj.IsNew = '@ViewBag.HasRateBefore' == 'False';
            obj.Score = parseInt(score);
            obj.IsContent = false;
            $.ajax({
                url: '@Url.Action("Rate", "Comment")',
                contentType: "application/json",
                data: JSON.stringify(obj),
                type: "Post",
                beforeSend: function () {
                },
                success: function (result) {
                    
                    if (result.status == "Succeed") {

                        window.location.reload();
                    }
                }
            });
        }
    }

</script>