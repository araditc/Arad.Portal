@model List<Arad.Portal.DataLayer.Entities.General.ContentCategory.ContentCategory>
<h2 class="text-center mt-3">Article Categories</h2>

<div class="container">
    <div class="row">
        @foreach (var category in Model)
        {
            var categoryName = category.CategoryNames.FirstOrDefault()?.Name ?? "Unnamed Category";
            var imageUrl = category.ContentPhotosSlider.Any() ? category.ContentPhotosSlider.First().Url : "/images/default-category.jpg";

            <div class="col-md-3 col-sm-6 col-12 p-2">
                <div class="category-box text-center p-3">
                    <img src="@(!string.IsNullOrEmpty(@imageUrl) ? @imageUrl : Url.Content("~/imgs/NoImage21.jpg"))" class="category-img" alt="@categoryName">
                    <a href="category/@categoryName"><h5 class="mt-2">@categoryName</h5></a>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .category-box {
            border: 1px solid #ddd;
            border-radius: 10px;
            background: #f8f9fa;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
            cursor: pointer;
            padding: 15px;
        }
        .category-img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 5px;
        }
    </style>
}
