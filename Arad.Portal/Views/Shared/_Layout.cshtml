@{
    string direction = HelpersMethods.GetDirection(CultureInfo.CurrentCulture);
    Result<Domain> domain = controllerHelper.FetchDefaultDomain();
    string lang = "";
    if (domain.ReturnValue.IsMultiLinguals)
    {
        lang = HelpersMethods.GetHtmlLang(CultureInfo.CurrentCulture);
    }
    else
    {
        Language language = controllerHelper.FetchLanguage(domain.ReturnValue.DefaultLanguageId);
        lang = language.Symbol;

        if (lang == "en-US")
        {
            direction = "ltr";
        }
        if (lang == "fa-IR")
        {
            direction = "rtl";
        }

    }
    // if (User.Identity.IsAuthenticated)
