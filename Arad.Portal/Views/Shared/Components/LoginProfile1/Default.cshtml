@using Arad.Portal.Helpers.Shared
@model bool
@inject ControllerHelper controllerHelper

<style>
    .myfont {
        font-family: '@ViewBag.FontFamily';
    }

    /* Add this style to move the unauthorized view down */
    .unauthorized-view {
        margin-top: 20px; /* Adjust the value as needed */
    }
</style>

<div class="col-6 col-lg-3">
    <div class="account-wrapper pt-2">
        <ul>
            @if (Model) // Show basket if the user has a shop
            {
                <li class="myfont shopping_cart home_cart">
                    <a asp-controller="basket" asp-action="get" title="" class="r-cart">
                        <span class="head-shoppings">
                            <i class="fa fa-shopping-basket shopping-basket"></i>
                            <span class="display-none count-basket" data-count="0">
                                @($"{ViewBag.BasketCount ?? 0} {UtilityLanguage.GetString("Stuff")}")
                            </span>
                        </span>
                    </a>
                </li>
            }

            <li class="myfont d-flex justify-content-center unauthorized-view">
                @if (!User.Identity.IsAuthenticated)
                {
                    <!-- Unauthorized Users -->
                    <div class="d-flex align-items-center">
                        <a href="~/Shared/Account/Login" class="d-inline-block">
                            <span class="title text-secondary">
                                <i class="fa fa-user"></i>
                                <span>Login</span>
                            </span>
                        </a>
                        <span class="d-inline-block mx-1">/</span>
                        <a href="~/Shared/Account/Register" class="d-inline-block">
                            <span class="title text-secondary">
                                <i class="fa fa-user"></i>
                                <span>Register</span>
                            </span>
                        </a>
                    </div>
                }
                else
                {
                    <!-- Authorized Users -->
                    <div class="dropdown d-flex align-items-center" id="myUserProfile">
                        <a class="openLoginModal btn dropdown-toggle" role="button" id="drpUserProfile"
                           placement="bottom right" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="title">
                                <i class="fa fa-user"></i>
                                <span>@(ViewBag.FullName ?? "")</span>
                            </span>
                        </a>
                        <div class="dropdown-menu p-2" aria-labelledby="drpUserProfile" style="font-size: 0.8rem; width: 18rem;">
                            <div class="d-flex justify-content-center">
                                <span>
                                    <img src="@(!string.IsNullOrWhiteSpace(ViewBag.ProfileUrl)
                                                    ? $"data:image/png;base64,{ViewBag.ProfileUrl}"
                                                    : Url.Content("~/imgs/NoImage21.jpg"))" style="width:50px;" loading="lazy" class="rounded-circle" alt="Profile Image" />
                                </span>
                            </div>
                            <div class="d-flex justify-content-center border-bottom">
                                <p class="my-2">@ViewBag.FullName</p>
                            </div>
                            <ul class="list-group">
                                @if (!string.IsNullOrEmpty(controllerHelper.GetCurrentUser().Result.UserRoleId))
                                {
                                    <li class="list-group-item border-0">
                                        <a href="~/Admin/Home/Index">
                                            Admin Panel Management
                                        </a>
                                    </li>
                                }
                                <li class="list-group-item border-0">
                                    <a href="~/Shared/Account/ChangeKnownPassword">
                                        ChangePassword
                                    </a>
                                </li>
                                <li class="list-group-item border-0">
                                    <a href="~/Shared/Account/Profile">
                                        Profile
                                    </a>
                                </li>
                                @if (Model)
                                {
                                    <li class="list-group-item border-0">
                                        <a asp-controller="Account" asp-action="GetUserOrders">
                                            My Orders
                                        </a>
                                    </li>
                                }
                                <li class="list-group-item border-0">
                                    <a href="~/Shared/Account/Logout">
                                        Exit
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </li>
        </ul>
    </div>
</div>
